rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@moviematch.com';
    }

    function isValidUserCreate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['USER', 'ADMIN']
        && (request.resource.data.role == 'USER' || isBootstrapAdmin());
    }

    function isValidSelfUpdate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['firstName', 'lastName', 'age', 'photoUrl', 'favoriteMovieIds', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isValidUserCreate(userId);
      allow update: if isAdmin() || isValidSelfUpdate(userId);
    }

    match /movies/{movieId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
